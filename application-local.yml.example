# 本机私有配置模板
#
# 用法：复制本文件为同目录下的 application-local.yml，把下面两个 CHANGE_ME 改成你自己的值。
# application-local.yml 已被 .gitignore 排除，不会被提交到 GitHub。
# 也可以完全不用这个文件，改用环境变量：DB_URL / DB_USERNAME / DB_PASSWORD /
# SUPER_ADMIN_PASSWORD（环境变量优先级高于本文件）。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/attendance_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: CHANGE_ME_DB_PASSWORD

app:
  super-admin:
    # 仅首次建库（库中不存在 superadmin）时生效；首次登录后请到账户管理里改掉。
    password: CHANGE_ME_SUPER_PASSWORD
